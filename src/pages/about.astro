---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config';
import { t } from '../i18n';
---
<BaseLayout title={t.about.title}>
  <section class="intro"><p class="eyebrow">{t.about.eyebrow}</p><h1>{t.about.heading}</h1><p>{site.description}</p></section>
  <div class="prose"><p>{t.about.guide} <code>src/config.ts</code> {t.about.guideAfter} <code>src/content/posts/</code> {t.about.guideEnd}</p><p>{t.about.philosophy}</p></div>
</BaseLayout>
