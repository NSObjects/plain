---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
export async function getStaticPaths(){
  const posts=await getCollection('posts',({data})=>!data.draft);
  return [...new Set(posts.flatMap(p=>p.data.tags))].map(tag=>({params:{tag},props:{tag}}));
}
const {tag}=Astro.props;
const posts=(await getCollection('posts',({data})=>!data.draft&&data.tags.includes(tag))).sort((a,b)=>b.data.publishedAt.getTime()-a.data.publishedAt.getTime());
const base=import.meta.env.BASE_URL;
---
<BaseLayout title={tag}>
  <section class="intro compact"><a class="back-link" href={base+'tags/'}>← 全部标签</a><h1>{tag}</h1><p>{posts.length} 篇文章</p></section>
  <div class="post-list">{posts.map(p=><article class="post-item"><div class="post-meta">{p.data.publishedAt.toLocaleDateString('zh-CN')}</div><h3><a href={base+'posts/'+p.id+'/'}>{p.data.title}</a></h3><p>{p.data.description}</p></article>)}</div>
</BaseLayout>
