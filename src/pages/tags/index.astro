---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n';
import { getCollection } from 'astro:content';
const posts=await getCollection('posts',({data})=>!data.draft);
const counts=new Map<string,number>();
for(const p of posts) for(const tag of p.data.tags)counts.set(tag,(counts.get(tag)??0)+1);
const tags=[...counts.entries()].sort((a,b)=>a[0].localeCompare(b[0]));
const base=import.meta.env.BASE_URL;
---
<BaseLayout title={t.tags.title}>
  <section class="intro compact"><h1>{t.tags.heading}</h1><p>{t.tags.intro}</p></section>
  <ul class="tag-directory">{tags.map(([tag,count])=><li><a href={base+'tags/'+encodeURIComponent(tag)+'/'}>{tag}</a><span>{t.tags.count(count)}</span></li>)}</ul>
</BaseLayout>
