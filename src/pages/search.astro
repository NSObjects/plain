---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="搜索">
  <section class="intro compact"><h1>搜索文章</h1><p>按标题、摘要或标签快速查找内容。</p></section>
  <div class="search-panel">
    <label for="query">关键词</label>
    <input id="query" type="search" placeholder="例如 Go、Agent、架构…" autocomplete="off" data-index={base + 'search-index.json'} />
    <p class="search-status" role="status" aria-live="polite">输入关键词开始搜索</p>
    <ul id="results" class="search-results"></ul>
  </div>
  <script>
    const input = document.querySelector<HTMLInputElement>('#query');
    const results = document.querySelector<HTMLUListElement>('#results');
    const status = document.querySelector<HTMLElement>('.search-status');
    if(input && results && status){
      let posts: Array<{title:string;description:string;tags:string[];url:string;date:string}> = [];
      let loadError = false;
      fetch(input.dataset.index!).then(r=>{if(!r.ok)throw new Error('index'); return r.json()})
        .then(data=>{posts=data; render()})
        .catch(()=>{loadError=true; status.textContent='索引加载失败，请刷新重试。'});
      const render=()=>{
        if(loadError)return;
        const q=input.value.trim().toLocaleLowerCase();
        results.replaceChildren();
        if(!q){status.textContent='输入关键词开始搜索';return}
        const match=posts.filter(p=>[p.title,p.description,...p.tags].some(s=>s.toLocaleLowerCase().includes(q)));
        status.textContent=`找到 ${match.length} 篇文章`;
        for(const p of match){
          const li=document.createElement('li'),a=document.createElement('a'),desc=document.createElement('p');
          a.href=p.url;a.textContent=p.title;desc.textContent=p.description;li.append(a,desc);results.append(li);
        }
      };
      input.addEventListener('input',render);
    }
  </script>
</BaseLayout>
