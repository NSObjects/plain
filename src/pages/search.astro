---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
const base = import.meta.env.BASE_URL;
---
<BaseLayout title={t.search.title}>
  <section class="intro compact"><h1>{t.search.heading}</h1><p>{t.search.intro}</p></section>
  <div class="search-panel">
    <label for="query">{t.search.keyword}</label>
    <input id="query" type="search" placeholder={t.search.placeholder} autocomplete="off" data-index={base + 'search-index.json'} data-empty={t.search.prompt} data-error={t.search.failure} data-found-zh={t.search.found(0)} data-locale={import.meta.env.SITE_LOCALE ?? ''} />
    <p class="search-status" role="status" aria-live="polite">{t.search.prompt}</p>
    <ul id="results" class="search-results"></ul>
  </div>
  <script>
    const input = document.querySelector<HTMLInputElement>('#query');
    const results = document.querySelector<HTMLUListElement>('#results');
    const status = document.querySelector<HTMLElement>('.search-status');
    if(input && results && status){
      const prompt = input.dataset.empty ?? '';
      const failure = input.dataset.error ?? '';
      const foundLabel = (n: number) => `${input.dataset.foundZh?.startsWith('找到') ? `找到 ${n} 篇文章` : `Found ${n} posts`}`;
      let posts: Array<{title:string;description:string;tags:string[];url:string;date:string}> = [];
      let loadError = false;
      fetch(input.dataset.index!).then(r=>{if(!r.ok)throw new Error('index'); return r.json()})
        .then(data=>{posts=data; render()})
        .catch(()=>{loadError=true; status.textContent=failure});
      const render=()=>{
        if(loadError)return;
        const q=input.value.trim().toLocaleLowerCase();
        results.replaceChildren();
        if(!q){status.textContent=prompt;return}
        const match=posts.filter(p=>[p.title,p.description,...p.tags].some(s=>s.toLocaleLowerCase().includes(q)));
        status.textContent=foundLabel(match.length);
        for(const p of match){
          const li=document.createElement('li'),a=document.createElement('a'),desc=document.createElement('p');
          a.href=p.url;a.textContent=p.title;desc.textContent=p.description;li.append(a,desc);results.append(li);
        }
      };
      input.addEventListener('input',render);
    }
  </script>
</BaseLayout>
